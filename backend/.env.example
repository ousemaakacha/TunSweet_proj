PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL pubblico del frontend, usato nei link di verifica (senza slash finale).
PUBLIC_SITE_URL=http://127.0.0.1:5173
# In produzione HTTPS il cookie Secure è obbligatorio (anche con NODE_ENV=production).
AUTH_COOKIE_SECURE=false
# Invio email: compilare con i dati SMTP del proprio servizio.
SMTP_HOST=
SMTP_PORT=587
# false per STARTTLS su 587, true per TLS su 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
